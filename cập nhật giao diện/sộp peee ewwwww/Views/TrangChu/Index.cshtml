                <div class="sp-banner-fallback">
                    <span class="sp-banner-kicker">MUA SẮM THÔNG MINH</span>
                    <h2>Ưu đãi mỗi ngày<br />Mua sắm thả ga!</h2>
                    <p>Khám phá nhiều ngành hàng yêu thích</p>
                    <a class="sp-banner-cta" href="@Url.Action("Index", "SanPham")">Khám phá →</a>
                    <div class="sp-banner-art" aria-hidden="true">🎧 📱 🎮</div>
                </div>
            </div>
            <div class="sp-banner-slide sp-banner-soft" aria-hidden="true" hidden>
