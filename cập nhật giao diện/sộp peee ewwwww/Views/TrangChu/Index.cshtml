                    <p>Thời trang · Công nghệ · Mỹ phẩm · Gia dụng</p>
                    <a class="sp-banner-cta" href="@Url.Action("Index", "SanPham")">Mua ngay →</a>
                    <div class="sp-banner-art" aria-hidden="true">🛍️ 🛒 🎁</div>
                </div>
            </div>
            <div class="sp-banner-slide sp-banner-blue" aria-hidden="true" hidden>
