        <button type="button" class="sp-banner-arrow sp-arrow-left" data-slide-prev aria-label="Banner trước">‹</button>
        <button type="button" class="sp-banner-arrow sp-arrow-right" data-slide-next aria-label="Banner sau">›</button>
        <div class="sp-banner-dots" aria-label="Chọn banner">
            <button type="button" class="sp-banner-dot is-active" data-slide-to="0" aria-label="Banner 1" aria-current="true"></button>
            <button type="button" class="sp-banner-dot" data-slide-to="1" aria-label="Banner 2"></button>
            <button type="button" class="sp-banner-dot" data-slide-to="2" aria-label="Banner 3"></button>
        </div>
