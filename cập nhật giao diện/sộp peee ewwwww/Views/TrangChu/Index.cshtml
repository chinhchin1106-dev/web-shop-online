@{
    ViewBag.Title = "Trang chủ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="sp-home sp-container" id="TrangChu">
    <section class="sp-banner-carousel" id="promoCarousel" aria-label="Banner quảng cáo Sộp Pe" aria-roledescription="carousel">
        <div class="sp-banner-track">
            <div class="sp-banner-slide is-active" aria-hidden="false">
                <img class="sp-banner-image" data-user-image
                     src="@Url.Content("~/Content/images/banner1_gioi_thieu.png")"
                     alt="Banner Sộp Pe - Thiên đường mua sắm" />
