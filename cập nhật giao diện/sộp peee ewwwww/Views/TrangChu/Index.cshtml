    <section class="sp-categories" id="danh-muc" aria-label="Danh mục sản phẩm">
        <a class="sp-category-tile" href="@Url.Action("Index", "SanPham", new { danhMuc = "Thời trang" })">
            <div class="sp-tile-image sp-image-frame">
                <span class="sp-image-fallback" aria-hidden="true">👕</span>
               
                <img data-user-image src="@Url.Content("~/Content/images/thoi trang.jpg")" alt="Thời trang" />
            </div>
            <div class="sp-category-copy"><strong>Thời trang</strong><small>Xu hướng mới</small></div>
            <span class="sp-tile-go" aria-hidden="true">›</span>
        </a>
        <a class="sp-category-tile" href="@Url.Action("Index", "SanPham", new { danhMuc = "Điện tử" })">
            <div class="sp-tile-image sp-image-frame">
                <span class="sp-image-fallback" aria-hidden="true">🎧</span>
              
                <img data-user-image src="@Url.Content("~/Content/images/connghde.jpg")" alt="Công nghệ" />
            </div>
            <div class="sp-category-copy"><strong>Công nghệ</strong><small>Đa dạng sản phẩm</small></div>
            <span class="sp-tile-go" aria-hidden="true">›</span>
        </a>
        <a class="sp-category-tile" href="@Url.Action("Index", "SanPham", new { danhMuc = "Mỹ phẩm" })">
            <div class="sp-tile-image sp-image-frame">
                <span class="sp-image-fallback" aria-hidden="true">💄</span>
               
                <img data-user-image src="@Url.Content("~/Content/images/mỹ phẩm.jpg")" alt="Mỹ phẩm" />
            </div>
            <div class="sp-category-copy"><strong>Mỹ phẩm</strong><small>Chăm sóc sắc đẹp</small></div>
            <span class="sp-tile-go" aria-hidden="true">›</span>
        </a>
        <a class="sp-category-tile" href="@Url.Action("Index", "SanPham", new { danhMuc = "Gia dụng" })">
            <div class="sp-tile-image sp-image-frame">
                <span class="sp-image-fallback" aria-hidden="true">🏠</span>
             
                <img data-user-image src="@Url.Content("~/Content/images/da dun jg.jpg")" alt="Gia dụng" />
            </div>
            <div class="sp-category-copy"><strong>Gia dụng</strong><small>Tiện nghi cho gia đình</small></div>
            <span class="sp-tile-go" aria-hidden="true">›</span>
        </a>
    </section>

    <section class="sp-featured" id="san-pham-noi-bat">
        <div class="sp-section-heading"><h2>Sản phẩm nổi bật</h2><p>Lựa chọn dành cho bạn</p></div>
        <div class="sp-product-grid"> 
    </section>
  
        <div class="sp-section-heading"><h2 id="spFavHeading">♡ Sản phẩm yêu thích</h2><p>Danh sách bạn đã lưu</p></div>
       
<section class="fm-quangcao">
