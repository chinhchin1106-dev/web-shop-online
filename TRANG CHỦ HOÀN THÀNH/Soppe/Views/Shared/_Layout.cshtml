@using Soppe.Security
@{
    var currentSearch = Request.QueryString["search"];

    // Đồng bộ danh tính từ Cookie mã hóa sang Session (tự khôi phục Session nếu hết hạn & kiểm tra SecurityStamp)
    int? maKHHienTai = AuthHelper.LayMaKHHienTai(Context);
    bool daDangNhap = User.Identity.IsAuthenticated && maKHHienTai.HasValue;

    string tenTaiKhoan = Convert.ToString(Session["HoTen"]);
    if (string.IsNullOrWhiteSpace(tenTaiKhoan) && User.Identity.IsAuthenticated)
    {
        tenTaiKhoan = User.Identity.Name;
    }

    bool laAdmin = daDangNhap && (
        User.IsInRole("Admin") ||
        string.Equals(Convert.ToString(Session["PhanQuyen"]), "Admin", StringComparison.OrdinalIgnoreCase)
    );
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@ViewBag.Title - Soppe</title>

    <link href="@Url.Content("~/Content/Site.css")?v=soppe-account-v6"
          rel="stylesheet" />

    <link href="@Url.Content("~/Content/Giohang.css")?v=20261022-1"
          rel="stylesheet" />

    <link href="@Url.Content("~/Content/Thongbao.css")"
          rel="stylesheet" />

    <style>
        .sp-account {
            position: relative;
        }

            .sp-account > summary {
                cursor: pointer;
                list-style: none;
            }

                .sp-account > summary::-webkit-details-marker {
                    display: none;
                }

            .sp-account .sp-account-menu {
                position: absolute;
                top: calc(100% + 12px);
                right: 0;
                z-index: 9999;
                width: 285px;
                max-width: calc(100vw - 24px);
                box-sizing: border-box;
                padding: 18px;
                background: #fff;
                border: 1px solid #e0eaf7;
                border-radius: 18px;
                box-shadow: 0 14px 35px rgba(37, 99, 235, .15);
                color: #183153;
                text-align: left;
            }

            .sp-account:not([open]) .sp-account-menu {
                display: none;
            }

            .sp-account[open] .sp-account-menu {
                animation: accountFadeIn .18s ease-out;
            }

        @@keyframes accountFadeIn {
            from {
                opacity: 0;
                transform: translateY(-6px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .sp-account-menu > strong {
            display: block;
            padding: 0 0 13px;
            margin: 0 0 14px;
            border-bottom: 1px solid #e5edf7;
            color: #174a91;
            font-size: 15px;
            font-weight: 700;
        }

        .sp-account-menu .account-user {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 12px;
            margin-bottom: 10px;
            background: #eff6ff;
            border-radius: 12px;
            color: #1d4ed8;
            font-size: 14px;
            font-weight: 600;
            line-height: 1.5;
            overflow-wrap: anywhere;
        }

        .sp-account-menu .account-status-online {
            display: inline-flex;
            align-items: center;
            padding: 7px 12px;
            margin-bottom: 10px;
            background: #dcfce7;
            border-radius: 30px;
            color: #15803d;
            font-size: 12px;
            font-weight: 600;
        }

        .sp-account-menu .account-status-admin {
            display: inline-flex;
            align-items: center;
            padding: 7px 12px;
            margin-bottom: 10px;
            background: #fef3c7;
            border-radius: 30px;
            color: #b45309;
            font-size: 12px;
            font-weight: 700;
        }

        .sp-account-menu .account-status-offline {
            display: block;
            padding: 10px 12px;
            margin-bottom: 12px;
            background: #f1f5f9;
            border-radius: 10px;
            color: #64748b;
            font-size: 13px;
        }

        .sp-account-menu form {
            display: block;
            margin: 12px 0 0;
            width: 100%;
        }

        .sp-account-menu .account-logout {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
            box-sizing: border-box;
            padding: 12px;
            background: #fff1f2;
            border: 1px solid #fecdd3;
            border-radius: 10px;
            color: #dc2626;
            font-family: inherit;
            font-size: 14px;
            font-weight: 600;
            text-align: center;
            cursor: pointer;
            transition: background .2s ease, transform .2s ease;
        }

            .sp-account-menu .account-logout:hover {
                background: #ffe4e6;
                transform: translateY(-1px);
            }

        .sp-account-menu a {
            display: block;
            padding: 11px 12px;
            margin-top: 5px;
            color: #1d4ed8;
            font-size: 14px;
            font-weight: 500;
            text-decoration: none;
            border-radius: 9px;
        }

            .sp-account-menu a:hover {
                background: #eff6ff;
            }

            .sp-account-menu a:focus-visible,
            .sp-account-menu .account-logout:focus-visible {
                outline: 2px solid #2563eb;
                outline-offset: 2px;
            }

        @@media (prefers-reduced-motion: reduce) {
            .sp-account[open] .sp-account-menu {
                animation: none;
            }

            .sp-account-menu .account-logout {
                transition: none;
            }
        }
    </style>
</head>

<body>

    <header class="sp-header">

        <div class="sp-container sp-header-main">

            <!-- LOGO -->
            <a href="@Url.Action("Index", "TrangChu")"
               class="logo-container">

                <img src="@Url.Content("~/Content/images/1792432802672_51234873273648295_6052778508993535726_29556a74d9d932425311588ec93c3ae6.jpg")"
                     alt="Logo Sộp Pe"
                     class="shop-logo" />

                <div class="logo-text">
                    <span class="logo-name">Sộp Pe</span>
                </div>
            </a>

            <!-- TÌM KIẾM -->
            <form class="sp-search header-search"
                  method="get"
                  action="@Url.Action("Index", "SanPham")"
                  role="search">

                <label for="spSearchInput" class="sr-only">
                    Tìm kiếm sản phẩm
                </label>

                <span class="sp-search-icon"
                      aria-hidden="true">⌕</span>

                <input id="spSearchInput"
                       type="search"
                       name="search"
                       value="@currentSearch"
                       placeholder="Bạn muốn tìm sản phẩm gì?"
                       autocomplete="off" />

                <button type="submit">
                    🔎 <span>Tìm kiếm</span>
                </button>
            </form>

            <div class="sp-tools">

                <!-- GIỎ HÀNG -->
                <a href="@Url.Action("Giohang", "TrangChu")"
                   class="sp-tool"
                   title="Giỏ hàng">

                    <span class="sp-tool-symbol"
                          aria-hidden="true">
                        🛒
                        <span id="headerCartCount"
                              class="sp-count"
                              hidden>0</span>
                    </span>

                    <span>Giỏ hàng</span>
                </a>

                <!-- YÊU THÍCH -->
                <a href="@Url.Action("Index", "TrangChu")#yeu-thich"
                   class="sp-tool"
                   title="Sản phẩm yêu thích">

                    <span class="sp-tool-symbol sp-outline-heart"
                          aria-hidden="true">
                        ♡
                        <span id="headerFavoriteCount"
                              class="sp-count"
                              hidden>0</span>
                    </span>

                    <span>Yêu thích</span>
                </a>

                <!-- THÔNG BÁO -->
                <a href="@Url.Action("ThongBao", "TrangChu")"
                   class="sp-tool sp-notice-tool"
                   title="Thông báo">

                    <span class="sp-tool-symbol"
                          aria-hidden="true">🔔</span>

                    <span>Thông báo</span>
                </a>

                <!-- TÀI KHOẢN -->
                <details class="sp-account site-dropdown"
                         id="accountDetails">

                    <summary class="sp-tool"
                             aria-label="Mở menu tài khoản"
                             title="Tài khoản">

                        <span class="sp-tool-symbol"
                              aria-hidden="true">👤</span>

                        <span>@(daDangNhap ? tenTaiKhoan : "Tài khoản")</span>
                    </summary>

                    <div class="sp-account-menu">

                        <strong>Tài khoản Sộp Pe</strong>

                        @if (daDangNhap)
                        {
                            <div class="account-user">
                                👤 Xin chào, @tenTaiKhoan
                            </div>

                            if (laAdmin)
                            {
                                <div class="account-status-admin">
                                    🛡️ Quản trị viên (Admin)
                                </div>

                                <a href="@Url.Action("Index", "Admin")">
                                    ⚙️ Quản trị hệ thống
                                </a>
                            }
                            else
                            {
                                <div class="account-status-online">
                                    ● Đã đăng nhập
                                </div>
                            }

                            <a href="@Url.Action("Index", "DonHang")">
                                📦 Lịch sử đơn hàng
                            </a>

                            using (Html.BeginForm(
                                "Dangxuat",
                                "TrangChu",
                                FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="account-logout">
                                    <span aria-hidden="true">↪</span> Đăng xuất
                                </button>
                            }
                        }
                        else
                        {
                            <div class="account-status-offline">
                                ● Chưa đăng nhập
                            </div>

                            <a href="@Url.Action("Dangnhap", "TrangChu")">
                                Đăng nhập
                            </a>

                            <a href="@Url.Action("Dangky", "TrangChu")">
                                Đăng ký
                            </a>
                        }

                    </div>
                </details>

            </div>
        </div>

        <!-- THANH DANH MỤC -->
        <div class="sp-nav-wrap">

            <div class="sp-container sp-nav-row">

                <details class="sp-category site-dropdown"
                         id="categoryDetails">

                    <summary class="sp-category-trigger">
                        ☰ &nbsp; Danh mục sản phẩm
                        <span>⌄</span>
                    </summary>

                    <div class="sp-category-menu">

                        <a href="@Url.Action("Index", "SanPham", new { danhMuc = "Thời trang" })">
                            👕 Thời trang <span>›</span>
                        </a>

                        <a href="@Url.Action("Index", "SanPham", new { danhMuc = "Điện tử" })">
                            🎧 Công nghệ <span>›</span>
                        </a>

                        <a href="@Url.Action("Index", "SanPham", new { danhMuc = "Mỹ phẩm" })">
                            💄 Mỹ phẩm <span>›</span>
                        </a>

                        <a href="@Url.Action("Index", "SanPham", new { danhMuc = "Gia dụng" })">
                            🏠 Gia dụng <span>›</span>
                        </a>

                    </div>
                </details>

                <!-- ĐIỀU HƯỚNG -->
                <nav class="sp-nav"
                     aria-label="Điều hướng trang">

                    <a href="@Url.Action("Index", "TrangChu")"
                       class="sp-nav-home">
                        Trang chủ
                    </a>

                    <a href="@Url.Action("Index", "SanPham")">
                        Sản phẩm
                    </a>

                    <a href="@Url.Action("Index", "UuDai")">
                        Ưu đãi
                    </a>

                    <a href="@Url.Action("Index", "TrangChu")#lien-he">
                        Liên hệ
                    </a>

                    @if (laAdmin)
                    {
                        <a href="@Url.Action("Index", "Admin")">
                            Quản trị
                        </a>
                    }

                </nav>

            </div>
        </div>

    </header>

    <!-- NỘI DUNG TRANG -->
    <main class="sp-main">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="sp-footer" id="lien-he">

        <div class="sp-container sp-footer-columns">

            <div>
                <h3>Sộp Pe</h3>

                <p>Nền tảng mua sắm trực tuyến tiện lợi.</p>

                <div class="sp-socials"
                     aria-label="Liên kết mạng xã hội chờ cấu hình">

                    <button type="button"
                            data-pending-link="Facebook"
                            aria-label="Facebook chưa cấu hình">
                        f
                    </button>

                    <button type="button"
                            data-pending-link="Instagram"
                            aria-label="Instagram chưa cấu hình">
                        ◎
                    </button>

                    <button type="button"
                            data-pending-link="YouTube"
                            aria-label="YouTube chưa cấu hình">
                        ▶
                    </button>

                    <button type="button"
                            data-pending-link="TikTok"
                            aria-label="TikTok chưa cấu hình">
                        ♪
                    </button>
                </div>
            </div>

            <div>
                <h4>Thông tin liên hệ</h4>

                <p>
                    ✉ Email: hotro@soppe.vn
                    <small>(demo)</small>
                </p>

                <p>
                    ☎ Hotline: 1900 1234
                    <small>(demo)</small>
                </p>
            </div>

            <div>
                <h4>Hỗ trợ khách hàng</h4>

                <p>Hướng dẫn mua hàng</p>
                <p>Chính sách đổi trả</p>
                <p>Câu hỏi thường gặp</p>
            </div>

        </div>

        <div class="sp-container sp-footer-bottom">
            © @DateTime.Now.Year Sộp Pe - Dự án học tập
        </div>

    </footer>

    <!-- NÚT LÊN ĐẦU TRANG -->
    <button type="button"
            id="spBackTop"
            class="sp-backtop"
            title="Lên đầu trang"
            aria-label="Lên đầu trang"
            hidden>
        ↑
    </button>

    <script src="@Url.Content("~/Scripts/Scripts.js")?v=soppe-20261022-v3"></script>

    @RenderSection("scripts", required: false)

</body>
</html>